{
  "name": "tasmin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Self-hosted Tasmota device manager (device dashboard + custom firmware builds)",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace server && npm run build --workspace web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "npm run test --workspace server"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.15.0"
  },
  "engines": {
    "node": ">=22"
  }
}
