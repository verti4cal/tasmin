# Development image: bakes in dependencies + toolchain only. Source is
# bind-mounted at runtime (see docker-compose.dev.yml) so tsx watch / Vite's
# dev server pick up file changes for hot reload without an image rebuild.
# Rebuilds are only needed when a package.json changes.
FROM node:22-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-pip python3-venv make g++ git ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && pip install --break-system-packages --no-cache-dir platformio

WORKDIR /repo

COPY package.json ./
COPY server/package.json server/package.json
COPY web/package.json web/package.json
RUN npm install

EXPOSE 3000 5173
