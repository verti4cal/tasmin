PORT=3000
DB_PATH=./data/app.db
LOG_LEVEL=info
DEVICE_POLL_INTERVAL_MS=30000
CORS_ORIGIN=http://localhost:5173

# Optional — omit to rely on HTTP polling only
MQTT_URL=

# Firmware compiler
GIT_COMMAND=git
PIO_COMMAND=pio
TASMOTA_REPO_URL=https://github.com/arendst/Tasmota.git
TASMOTA_SRC_DIR=./data/tasmota-src
FIRMWARE_OUTPUT_DIR=./data/firmware-builds

# Telemetry history retention
TELEMETRY_RETENTION_DAYS=14

# Required for pushing firmware to devices (OTA tab / firmware push button):
# the IP or domain (optionally with a port) that Tasmota devices on your
# network can use to reach this server, so they can pull firmware from it.
# The container's own address usually isn't reachable from the LAN.
OTA_URL_DOMAIN=192.168.1.50:3000
